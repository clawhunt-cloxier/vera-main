    },
    "/api/v1/reports/{id}/versions/{version}/feedback": {
      "post": {
        "operationId": "submitFeedback",
        "summary": "submitFeedback",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feedback"
                }
              }
            }
          },
          "default": {
            "description": "Structured error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackInput"
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "get": {
        "operationId": "login",
        "security": [],
        "responses": {
          "302": {
            "description": "OIDC redirect; state/nonce/PKCE verified"
          },
          "400": {
            "description": "Invalid authentication flow"
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "callback",
        "security": [],
        "responses": {
          "302": {
            "description": "OIDC redirect; state/nonce/PKCE verified"
          },
          "400": {
            "description": "Invalid authentication flow"
          }
        },
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session destroyed"
          },
          "403": {
            "description": "Invalid CSRF"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "vera_session"
      }
    },
    "schemas": {
      "CreateTask": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "template_id": {
            "const": "annual_financial_review"
          },
          "template_version": {
            "const": "1.0.0"
          },
          "entity_id": {
            "type": "string",
            "format": "uuid"
          },
          "report_year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          },
          "research_as_of": {
            "type": "string",
            "format": "date-time"
          },
          "as_of_mode": {
            "const": "public_as_of"
          },
          "purpose": {
            "const": "trial_research"
          },
          "locale": {
            "const": "zh-CN"
          }
        },
        "required": [
          "template_id",
          "template_version",
          "entity_id",
          "report_year",
          "research_as_of",
          "as_of_mode",
          "purpose",
          "locale"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        },
        "required": [
          "request_id",
          "error"
        ]
      },
      "ReportRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "PREPARING",
              "WAITING_EVIDENCE",
              "ANALYZING",
              "VERIFYING",
              "ASSEMBLING",
              "FINAL_CHECK",
              "DELIVERING",
              "CANCEL_REQUESTED",
              "COMPLETED",
              "ABSTAINED",
              "BUDGET_EXHAUSTED",
              "CANCELLED",
              "BLOCKED",
              "FAILED"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "stage_label": {
            "type": "string"
          },
          "report_ref": {
            "$ref": "#/components/schemas/ReportRef"
          },
          "reason_code": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "revision",
          "created_at",
          "deadline",
          "stage_label"
        ]
      },
      "Entity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "supported": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "symbol",
          "venue",
          "supported"
        ]
      },
      "Me": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "csrf_token": {
            "type": "string"
          },
          "daily_remaining": {
            "type": "integer",
            "minimum": 0
          },
          "persona": {
            "enum": [
              "fund_manager",
              "retail",
              "unspecified"
            ]
          }
        },
        "required": [
          "user_id",
          "workspace_id",
          "csrf_token",
          "daily_remaining",
          "persona"
        ]
      },
      "Cancel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_revision"
        ]
      },
      "FeedbackInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "useful",
              "confusing",
              "incorrect",
              "other"
            ]
          },
          "comment": {
            "type": "string",
            "maxLength": 2000
          },
          "claim_ref": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ]
      },
      "Feedback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "created_at"
        ]
      },
      "Coverage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^[RO][0-9]{2}$"
          },
          "status": {
            "enum": [
              "SATISFIED",
              "NOT_DISCLOSED",
              "NOT_APPLICABLE",
              "UNAVAILABLE",
              "MISSING",
              "CONFLICT"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "requirement_id",
          "status"
        ]
      },
      "Claim": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "type": {
            "enum": [
              "fact",
              "calculation",
              "inference"
            ]
          },
          "text": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "calculation_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ref",
          "type",
          "text",
          "evidence_refs",
          "calculation_refs",
          "limitations"
        ]
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source_title": {
            "type": "string"
          },
          "source_published_at": {
            "type": "string",
            "format": "date-time"
          },
          "origin_group_id": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "source_tier": {
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4",
              "L5"
            ]
          },
          "statement_kind": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_title",
          "source_published_at",
          "origin_group_id",
          "content_hash",
          "locator",
          "excerpt",
          "source_tier",
          "statement_kind"
        ]
      },
      "Calculation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "formula_id": {
            "type": "string"
          },
          "formula_version": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "value": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "evidence_id",
                "value",
                "unit"
              ]
            }
          },
          "result": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "applicability": {
            "enum": [
              "APPLICABLE",
              "NOT_APPLICABLE",
              "MISSING_INPUT",
              "CONFLICT"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "formula_id",
          "formula_version",
          "inputs",
          "result",
          "unit",
          "applicability"
        ]
      },
      "Report": {
