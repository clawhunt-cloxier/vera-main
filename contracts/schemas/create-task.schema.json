{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "template_id": {
      "const": "general_research"
    },
    "template_version": {
      "const": "1.0.0"
    },
    "entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "research_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "as_of_mode": {
      "const": "public_as_of"
    },
    "purpose": {
      "const": "trial_research"
    },
    "locale": {
      "const": "zh-CN"
    },
    "research_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start",
        "end"
      ]
    }
  },
  "required": [
    "template_id",
    "template_version",
    "entity_id",
    "research_as_of",
    "as_of_mode",
    "purpose",
    "locale",
    "research_question",
    "time_range"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
