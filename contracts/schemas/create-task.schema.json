{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Confirms a server-side research plan. Skill, subject, params and data scope come from the plan, never from this request.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "disabled_sections": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^S[0-9X]{1,2}$"
      }
    }
  },
  "required": [
    "plan_id",
    "plan_hash",
    "disabled_sections"
  ]
}
