{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Initial budget and quota policy from ADR-0003 D7. Values are configuration, revised after T020/T021 measurements by a new policy version.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deadline_seconds": {"type": "integer", "minimum": 10, "maximum": 3600},
        "max_model_calls": {"type": "integer", "minimum": 1, "maximum": 200},
        "input_tokens": {"type": "integer", "minimum": 1000},
        "output_tokens": {"type": "integer", "minimum": 100},
        "cost_limit_usd": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"}
      },
      "required": ["deadline_seconds", "max_model_calls", "input_tokens", "output_tokens", "cost_limit_usd"]
    }
  },
  "properties": {
    "version": {"const": "p0-2"},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stock_analysis": {"$ref": "#/$defs/budget"},
        "capital_flow": {"$ref": "#/$defs/budget"},
        "deep_research": {"$ref": "#/$defs/budget"},
        "plan_parse": {"$ref": "#/$defs/budget"}
      },
      "required": ["stock_analysis", "capital_flow", "deep_research", "plan_parse"]
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_active_tasks": {"type": "integer", "minimum": 1},
        "user_queued_tasks": {"type": "integer", "minimum": 0},
        "user_daily_tasks": {"type": "integer", "minimum": 1},
        "user_daily_deep_research": {"type": "integer", "minimum": 0},
        "platform_in_flight_tasks": {"type": "integer", "minimum": 1},
        "platform_model_concurrency": {"type": "integer", "minimum": 1},
        "per_task_model_concurrency": {"type": "integer", "minimum": 1},
        "platform_daily_cost_limit_usd": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"},
        "plan_parse_per_user_per_minute": {"type": "integer", "minimum": 1}
      },
      "required": ["user_active_tasks", "user_queued_tasks", "user_daily_tasks", "user_daily_deep_research", "platform_in_flight_tasks", "platform_model_concurrency", "per_task_model_concurrency", "platform_daily_cost_limit_usd", "plan_parse_per_user_per_minute"]
    },
    "model_call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http_timeout_seconds": {"type": "integer", "minimum": 1},
        "transient_retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "format_repairs": {"type": "integer", "minimum": 0, "maximum": 1},
        "unknown_result_hold_hours": {"type": "integer", "minimum": 1}
      },
      "required": ["http_timeout_seconds", "transient_retries", "format_repairs", "unknown_result_hold_hours"]
    }
  },
  "required": ["version", "budgets", "quota", "model_call"]
}
