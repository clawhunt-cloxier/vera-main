{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Either free text or a structured skill+subject request. Free text is untrusted input used only for parsing.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "text"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "enum": [
            "deep_research",
            "stock_analysis",
            "capital_flow"
          ]
        },
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "params": {
          "type": "object",
          "description": "Validated server-side against the skill's params_schema from GET /api/v1/skills."
        }
      },
      "required": [
        "skill_id",
        "subject_id",
        "params"
      ]
    }
  ]
}
