        },
        {
          "name": "value",
          "type": "decimal",
          "unit": "CNY",
          "required": false,
          "description": "科目金额；未披露为空并附原因"
        },
        {
          "name": "revision",
          "type": "integer",
          "unit": "count",
          "required": true,
          "description": "更正版本序号，原始披露为 0"
        },
        {
          "name": "filing_id",
          "type": "string",
          "unit": "none",
          "required": true,
          "description": "对应公告的 doc.announcement 记录 ID"
        }
      ]
    },
