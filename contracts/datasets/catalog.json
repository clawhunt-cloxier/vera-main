        },
        {
          "name": "report_type",
          "type": "enum",
          "values": [
            "Q1",
            "H1",
            "Q3",
            "FY"
          ],
          "unit": "none",
          "required": true,
          "description": "报告类型；利润表与现金流量表为年初至报告期末累计值"
        },
        {
          "name": "scope",
          "type": "enum",
          "values": [
            "consolidated",
            "parent"
          ],
          "unit": "none",
          "required": true,
          "description": "合并或母公司"
