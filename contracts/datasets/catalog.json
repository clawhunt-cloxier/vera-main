{
  "version": "2",
  "description": "Unified dataset field dictionary (DATA_SERVICE §3–4). Envelope fields (record_id, entity_id, published_at, available_at, provider_id, source_tier, ...) are common to every dataset and not repeated here. Monetary values are CNY yuan; ratios are decimal fractions (0.1234 = 12.34%).",
  "units": {
    "CNY": "人民币元",
    "shares": "股",
    "ratio": "比例，小数表示",
    "times": "倍",
    "count": "个数",
    "index_point": "指数点",
    "none": "无单位"
  },
  "datasets": [
    {
      "id": "ref.security",
      "title": "证券主数据",
      "origin": "exchange",
      "default_tier": "L2",
      "grain": [
        "entity_id"
      ],
      "mvp": true,
      "fields": [
        {
          "name": "security_code",
          "type": "string",
          "unit": "none",
          "required": true,
          "description": "交易所代码，如 600519.SH"
        },
        {
          "name": "short_name",
          "type": "string",
          "unit": "none",
          "required": true,
          "description": "证券简称"
        },
        {
          "name": "exchange",
          "type": "enum",
          "values": [
            "SH",
            "SZ",
            "BJ",
            "DEMO"
          ],
          "unit": "none",
          "required": true,
          "description": "交易所；DEMO 仅用于 fixture 演示数据，production 拒绝"
        },
        {
          "name": "board",
          "type": "enum",
          "values": [
            "main",
            "chinext",
            "star",
            "bse"
          ],
          "unit": "none",
          "required": true,
          "description": "板块"
        },
        {
          "name": "list_date",
          "type": "date",
          "unit": "none",
          "required": true,
          "description": "上市日期"
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "listed",
            "suspended",
            "st",
            "delisting",
            "delisted"
          ],
          "unit": "none",
          "required": true,
          "description": "交易状态"
        },
        {
          "name": "is_financial",
          "type": "boolean",
          "unit": "none",
          "required": true,
          "description": "是否金融类公司（银行、保险、证券、多元金融），决定财务章节适用性"
        },
        {
          "name": "margin_eligible",
          "type": "boolean",
          "unit": "none",
          "required": true,
          "description": "当前是否为融资融券标的"
        },
        {
          "name": "total_shares",
          "type": "decimal",
          "unit": "shares",
          "required": true,
          "description": "总股本"
        },
        {
          "name": "float_shares",
          "type": "decimal",
          "unit": "shares",
          "required": true,
          "description": "流通股本"
        }
      ]
    },
    {
      "id": "ref.industry",
      "title": "行业分类与成分",
      "origin": "vendor_derived",
      "default_tier": "L2",
      "grain": [
        "entity_id",
        "taxonomy",
        "valid_from"
      ],
      "mvp": true,
      "fields": [
        {
          "name": "taxonomy",
          "type": "enum",
          "values": [
            "SW2021"
          ],
          "unit": "none",
          "required": true,
          "description": "分类体系与版本"
        },
        {
          "name": "level1_code",
          "type": "string",
          "unit": "none",
          "required": true,
          "description": "一级行业代码"
        },
        {
          "name": "level1_name",
          "type": "string",
          "unit": "none",
          "required": true,
          "description": "一级行业名称"
        },
        {
          "name": "level2_code",
          "type": "string",
          "unit": "none",
          "required": true,
          "description": "二级行业代码"
        },
        {
          "name": "level2_name",
          "type": "string",
          "unit": "none",
          "required": true,
          "description": "二级行业名称"
        },
        {
          "name": "valid_from",
          "type": "date",
          "unit": "none",
          "required": true,
          "description": "分类生效日"
        },
        {
          "name": "valid_to",
          "type": "date",
          "unit": "none",
          "required": false,
          "description": "分类失效日，空表示当前有效"
        }
      ]
    },
    {
      "id": "ref.trading_calendar",
      "title": "交易日历",
      "origin": "exchange",
      "default_tier": "L1",
      "grain": [
        "trade_date"
      ],
      "mvp": true,
      "fields": [
        {
          "name": "trade_date",
          "type": "date",
          "unit": "none",
          "required": true,
          "description": "日期"
        },
        {
          "name": "is_open",
          "type": "boolean",
          "unit": "none",
          "required": true,
          "description": "是否交易日"
        }
      ]
    },
    {
      "id": "mkt.intraday_quote",
      "title": "个股盘中行情快照",
      "origin": "exchange",
      "default_tier": "L2",
      "grain": ["entity_id", "event_at", "provider_id"],
      "mvp": true,
      "fields": [
        {"name": "event_at", "type": "datetime", "unit": "none", "required": true, "description": "行情事件时间，RFC3339 含时区；须验证厂商含义"},
        {"name": "received_at", "type": "datetime", "unit": "none", "required": true, "description": "系统接收时间，RFC3339 含时区"},
        {"name": "last_price", "type": "decimal", "unit": "CNY", "required": true, "description": "最近成交价，元；须确认厂商口径"},
        {"name": "market_status", "type": "enum", "values": ["continuous", "suspended", "closed", "unknown"], "unit": "none", "required": true, "description": "交易状态；厂商枚举未确认时不得推断"},
        {"name": "latency_mode", "type": "enum", "values": ["real_time", "delayed", "unknown"], "unit": "none", "required": true, "description": "经授权及能力核实的延迟性质；未知不得标为实时"},
        {"name": "delay_ms", "type": "integer", "unit": "none", "required": false, "description": "已确认的延迟毫秒数；未知不填"}
      ]
    },
    {
      "id": "mkt.intraday_index_quote",
      "title": "指数盘中行情快照",
      "origin": "exchange",
      "default_tier": "L2",
      "grain": ["index_code", "event_at", "provider_id"],
      "mvp": true,
      "fields": [
        {"name": "index_code", "type": "string", "unit": "none", "required": true, "description": "指数代码，须明确基准和市场"},
        {"name": "event_at", "type": "datetime", "unit": "none", "required": true, "description": "行情事件时间，RFC3339 含时区；须验证厂商含义"},
        {"name": "received_at", "type": "datetime", "unit": "none", "required": true, "description": "系统接收时间，RFC3339 含时区"},
        {"name": "last_value", "type": "decimal", "unit": "index_point", "required": true, "description": "指数最新点位；须确认厂商口径"},
        {"name": "market_status", "type": "enum", "values": ["continuous", "suspended", "closed", "unknown"], "unit": "none", "required": true, "description": "交易状态；厂商枚举未确认时不得推断"},
        {"name": "latency_mode", "type": "enum", "values": ["real_time", "delayed", "unknown"], "unit": "none", "required": true, "description": "经授权及能力核实的延迟性质；未知不得标为实时"},
        {"name": "delay_ms", "type": "integer", "unit": "none", "required": false, "description": "已确认的延迟毫秒数；未知不填"}
      ]
    },
    {
      "id": "mkt.daily_bar",
      "title": "个股日线",
      "origin": "exchange",
      "default_tier": "L2",
      "grain": [
        "entity_id",
        "trade_date"
      ],
      "mvp": true,
      "fields": [
        {
          "name": "trade_date",
          "type": "date",
          "unit": "none",
          "required": true,
          "description": "交易日"
        },
        {
          "name": "open",
          "type": "decimal",
          "unit": "CNY",
          "required": true,
          "description": "开盘价（不复权）"
        },
        {
          "name": "high",
          "type": "decimal",
          "unit": "CNY",
          "required": true,
          "description": "最高价（不复权）"
        },
        {
          "name": "low",
          "type": "decimal",
          "unit": "CNY",
          "required": true,
          "description": "最低价（不复权）"
        },
        {
          "name": "close",
          "type": "decimal",
          "unit": "CNY",
          "required": true,
          "description": "收盘价（不复权）"
        },
        {
          "name": "pre_close",
          "type": "decimal",
          "unit": "CNY",
          "required": true,
          "description": "前收盘价（除权调整后）"
        },
        {
          "name": "volume",
          "type": "decimal",
          "unit": "shares",
          "required": true,
          "description": "成交量，股；厂商以手返回时在映射中换算"
        },
        {
          "name": "amount",
          "type": "decimal",
          "unit": "CNY",
          "required": true,
          "description": "成交额"
        },
        {
          "name": "turnover_rate",
          "type": "decimal",
          "unit": "ratio",
          "required": false,
          "description": "换手率（基于流通股本）"
        },
        {
          "name": "adj_factor",
          "type": "decimal",
          "unit": "none",
          "required": true,
          "description": "后复权因子，复权价 = 价格 × 因子"
        },
        {
          "name": "suspended",
          "type": "boolean",
          "unit": "none",
          "required": true,
          "description": "当日是否停牌；停牌日价格沿用前收、成交为 0"
        }
      ]
    },
