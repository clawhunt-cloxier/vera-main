{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "greeting",
        "thanks",
        "capabilities",
        "education",
        "decline_advice",
        "clarify",
        "unavailable",
        "out_of_scope"
      ]
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "^[a-z_]+$",
            "description": "A concept ID from the registered catalogue in the prompt."
          },
          "aspect": {
            "type": "string",
            "description": "定义用 definition，统计口径或研究方法用 method，适用条件、风险和局限用 limits，概览用 overview。",
            "enum": [
              "definition",
              "method",
              "limits",
              "overview"
            ]
          }
        },
        "required": [
          "topic",
          "aspect"
        ]
      }
    }
  },
  "required": [
    "kind",
    "concepts"
  ]
}
