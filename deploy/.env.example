# Vera Deployment Environment Variables
# Copy this to .env and fill in your values

# Database (use managed PostgreSQL for production)
VERA_DB_DSN=postgres://user:password@host:5432/vera?sslmode=require

# Session security (generate with: openssl rand -base64 32)
VERA_SESSION_SECRET=

# OIDC (Google or custom provider)
VERA_OIDC_ISSUER=https://accounts.google.com
VERA_OIDC_CLIENT_ID=
VERA_OIDC_CLIENT_SECRET=

# Model provider
VERA_MODEL_PROVIDER=openai
VERA_MODEL_API_KEY=
VERA_MODEL_BASE_URL=

# Feature flags
VERA_REGISTRATION_ENABLED=false
VERA_REAL_RESEARCH_ENABLED=false

# Data provider credentials (JSON format)
# VERA_DS_CREDENTIALS=
