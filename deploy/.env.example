# Copy to /opt/vera/.env on the server (chmod 600). Placeholders only; never commit real values.

# Image tag deployed by CD (defaults to :dev)
# VERA_IMAGE=ghcr.io/clawhunt-cloxier/vera-main:dev

# Public URL used for redirects and Origin checks
VERA_PUBLIC_URL=https://vera.touziagent.com
VERA_REGISTRATION_ENABLED=true
VERA_REAL_RESEARCH_ENABLED=true
VERA_DAILY_MODEL_COST_LIMIT_USD=20.00

# Models (OpenAI-compatible adapter, e.g. DeepSeek). Writer/verifier/router share one key.
MODEL_PRICE_TABLE_VERSION=
MODEL_WRITER_ADAPTER=openai
MODEL_WRITER_BASE_URL=
MODEL_WRITER_ID=
MODEL_WRITER_API_KEY=
MODEL_WRITER_EXTRA_BODY={"thinking":{"type":"disabled"}}
MODEL_VERIFIER_ADAPTER=openai
MODEL_VERIFIER_BASE_URL=
MODEL_VERIFIER_ID=
MODEL_VERIFIER_API_KEY=
MODEL_VERIFIER_EXTRA_BODY={"thinking":{"type":"disabled"}}
MODEL_ROUTER_ADAPTER=openai
MODEL_ROUTER_BASE_URL=
MODEL_ROUTER_ID=
MODEL_ROUTER_API_KEY=
MODEL_ROUTER_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Real closed-market brief (provision licenses explicitly before switching).
# VERA_DATA_PROVIDER=emquant
# 切换为 tushare 后，vera sync 采集指定公司及其同行。详见 docs/TUSHARE.md。
# VERA_DATA_PROVIDER=tushare
# VERA_REQUIRE_CHOICE_QUOTE=false
# TUSHARE_SUBJECTS=600519.SH
# TUSHARE_TOKEN=
# TUSHARE_MIN_INTERVAL=500ms
# TUSHARE_ALLOW_MODEL_PROCESSING=false
# TUSHARE_S3_ENDPOINT=http://storage:8333
# TUSHARE_S3_REGION=us-east-1
# TUSHARE_S3_ACCESS_KEY=
# TUSHARE_S3_SECRET_KEY=
# TUSHARE_S3_BUCKET=vera-raw
# EMQUANT_LIBRARY=/opt/choice-sdk/libEMQuantAPIx64.so
# EMQUANT_USER=
# EMQUANT_PASSWORD=
# EMQUANT_ACCOUNT_SCOPE=choice-primary-single-session
# EMQUANT_S3_ENDPOINT=http://storage:8333
# EMQUANT_S3_REGION=us-east-1
# EMQUANT_S3_ACCESS_KEY=
# EMQUANT_S3_SECRET_KEY=
# EMQUANT_S3_BUCKET=vera-raw
# EMQUANT_S3_PREFIX=brief
# EMQUANT_PROVIDER_ID=choice
# EMQUANT_PRODUCT=<verified-product-code>
# EMQUANT_MIN_INTERVAL=1s
# EMQUANT_RATE_COOLDOWN=60s
# The 0.4 quote path is enabled only after the controlled Choice governance
# registration has completed in the application database. It resolves every
# requested mainland stock dynamically; no stock-code allowlist or governance
# identifier belongs in deployment configuration. Keep the registration
# inputs in the secret manager and leave this example file free of instances.
# Set VERA_REQUIRE_CHOICE_QUOTE=true only after init-quote has completed.
