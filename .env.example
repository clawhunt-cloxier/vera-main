# No credentials. Copy to ignored .env for future integration tasks.
VERA_ENV=development
VERA_ADDR=127.0.0.1:8080
VERA_REAL_RESEARCH_ENABLED=false
VERA_REGISTRATION_ENABLED=false
# Required later, deliberately no real defaults:
DATABASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
# Model profiles (writer/verifier/router). Exact model_id and price table are required before any real call.
MODEL_WRITER_BASE_URL=
MODEL_WRITER_ID=
MODEL_WRITER_API_KEY=
MODEL_VERIFIER_BASE_URL=
MODEL_VERIFIER_ID=
MODEL_VERIFIER_API_KEY=
MODEL_ROUTER_BASE_URL=
MODEL_ROUTER_ID=
MODEL_ROUTER_API_KEY=
MODEL_PRICE_TABLE_VERSION=
# Data providers are configured per provider in T014; credentials by secret reference only.
VERA_PROVIDER_CONFIG=
VERA_DAILY_MODEL_COST_LIMIT_USD=30.00
